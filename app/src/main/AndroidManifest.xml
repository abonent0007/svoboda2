<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Полный список установленных приложений для per-app раздельного туннелирования.
         Дистрибуция — GitHub Releases (не Play), поэтому QUERY_ALL_PACKAGES допустим;
         список приложений никуда не отправляется (только локальный UI и VpnService). -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- Foreground service для VPN (targetSdk 35, Android 14+). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />
    <!-- Автообновление: установка скачанного APK через системный установщик. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Видимость установленных приложений для split-tunnel (Android 11+). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <package android:name="com.avito.android" />
        <package android:name="com.idamob.tinkoff.android" />
        <package android:name="com.octopod.russianpost.client.android" />
        <package android:name="com.sberbank.spasibo" />
        <package android:name="com.vkontakte.android" />
        <package android:name="com.wildberries.ru" />
        <package android:name="com.yandex.browser" />
        <package android:name="ru.alfabank.mobile.android" />
        <package android:name="ru.dns.shop.android" />
        <package android:name="ru.dodopizza.app" />
        <package android:name="ru.emias.mobile" />
        <package android:name="ru.fns.chek" />
        <package android:name="ru.fns.lkfl" />
        <package android:name="ru.gazprombank.android.mobilebank" />
        <package android:name="ru.gosuslugi.android" />
        <package android:name="ru.gosuslugi.auto" />
        <package android:name="ru.gosuslugi.goskey" />
        <package android:name="ru.ivi.client" />
        <package android:name="ru.kinopoisk" />
        <package android:name="ru.lamoda.app" />
        <package android:name="ru.mail.mailapp" />
        <package android:name="ru.mos.app" />
        <package android:name="ru.mos.parking" />
        <package android:name="ru.mosmetro.metro" />
        <package android:name="ru.mts.bank" />
        <package android:name="ru.ok.android" />
        <package android:name="ru.open.mb" />
        <package android:name="ru.ozon.app.android" />
        <package android:name="ru.pochta.bank" />
        <package android:name="ru.psbank.mobile" />
        <package android:name="ru.raiffeisennews" />
        <package android:name="ru.rosbank.app" />
        <package android:name="ru.rt.atv.ultimate" />
        <package android:name="ru.sberbankmobile" />
        <package android:name="ru.sovcombank.mobile" />
        <package android:name="ru.tele2.mytele2" />
        <package android:name="ru.tinkoff.investing" />
        <package android:name="ru.tinkoff.mb" />
        <package android:name="ru.vkusvill" />
        <package android:name="ru.vtb.mobile" />
        <package android:name="ru.vtb24.mobilebanking.android" />
        <package android:name="ru.yandex.disk" />
        <package android:name="ru.yandex.market" />
        <package android:name="ru.yandex.money" />
        <package android:name="ru.yandex.music" />
        <package android:name="ru.yandex.searchplugin" />
        <package android:name="ru.yandex.taxi" />
        <package android:name="ru.yandex.yandexmaps" />
        <package android:name="ru.yandex.yandexnavi" />
    </queries>

    <application
        android:name=".SvobodaApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Svoboda">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
